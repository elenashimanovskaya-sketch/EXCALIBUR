    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем массаж Асахи отличается от гуаша?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Гуаша - скребок и более выраженное скольжение по поверхности. Асахи - преимущественно пальцевая работа с акцентом на лимфоузлы и мягкое снятие тонуса. Можно сочетать, но не в одной сессии при чувствительной коже."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько минут делать массаж Асахи дома?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Базовый протокол - 8–12 минут. Для первых недель лучше 8 минут без форсирования. Если кожа краснеет - сократите до 5–6 минут и снизьте давление."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли делать Асахи каждый день?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При спокойной коже - да, но я рекомендую начинать с 3–4 раз в неделю. Так проще отследить реакцию и не перегрузить ткани."
          }
        },
        {
          "@type": "Question",
          "name": "Когда ждать первый видимый результат?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По ощущениям - через 1–2 недели: меньше утренней тяжести, мягче контур. Визуальные изменения зависят от застоя лимфы, сна и ухода; ориентир - 3–4 недели регулярности."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли специальный крем для Зоган?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нужно средство скольжения: масло, эмульсия или лёгкий крем без спирта. Отдельный крем для Асахи не обязателен. После массажа - ваш базовый уход."
          }
        }
      ]
    },
