      "step": [
        {
          "@type": "HowToStep",
          "name": "Растяжка платизмы",
          "text": "Поднимите подбородок, нижняя губа чуть вперёд, удерживайте 5 секунд, 5 повторов."
        },
        {
          "@type": "HowToStep",
          "name": "O-губы",
          "text": "Округлите губы, мягко тяните уголки вниз, удерживайте 3 секунды, 8 повторов."
        },
        {
          "@type": "HowToStep",
          "name": "Скольжение по линии челюсти",
          "text": "Подушечками от уха к подбородку 6–8 медленных проходов с каждой стороны."
        },
        {
          "@type": "HowToStep",
          "name": "Язык к нёбу",
          "text": "Прижмите язык к твёрдому нёбу, лёгкое напряжение под подбородком 5 секунд, 6 повторов."
        },
        {
          "@type": "HowToStep",
          "name": "Лимфопоглаживание",
          "text": "На второй неделе 2 минуты ведите ладони от центра лица к ключицам."
        }
      ]
    }
